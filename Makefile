GOPATH ?= /tmp/gopath
GOMODCACHE ?= /tmp/gomodcache

export GOPATH
export GOMODCACHE

.PHONY: test cover lint fmt vet check

# Files this module owns and hand-writes. Two subtrees are excluded:
#
#   internal/fixture   a separate Go module whose ent/ subtree is ent-generated
#   internal/fixtures  this module's codegen fixtures, regenerated by
#                      TestCodegenFixtures on every `make test`
#
# Both are generated (DO NOT EDIT). gofmt/goimports walk the filesystem rather
# than the module graph, so they must be pointed at an explicit list or they
# rewrite import grouping in generated files on every run — and for
# internal/fixtures that fight is unwinnable, since the next test run rewrites
# them back.
#
# internal/fixtures/*/ent/schema is hand-written but sits under the excluded
# prefix; keep it gofmt-clean by hand.
FMT_FILES = $(shell find . -name '*.go' -not -path './internal/fixture/*' -not -path './internal/fixtures/*')

# Includes TestCodegenFixtures, which regenerates internal/fixtures/*/ent and
# compiles the result. It is the only gate that proves generated code builds,
# so it stays in the default target. Adds roughly 2s.
test:
	go test -count=1 -v ./...

cover:
	go test -count=1 -coverprofile=coverage.out ./...
	go tool cover -func=coverage.out | tail -1
	@rm -f coverage.out

lint:
	golangci-lint run ./...

fmt:
	gofmt -w $(FMT_FILES)
	goimports -w -local github.com/githonllc/entdomain $(FMT_FILES)

vet:
	go vet ./...

check: fmt vet test
