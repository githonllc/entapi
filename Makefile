GOPATH ?= /tmp/gopath
GOMODCACHE ?= /tmp/gomodcache

export GOPATH
export GOMODCACHE

.PHONY: test test-modules cover lint fmt vet check

# Files this module owns and hand-writes. Two subtrees are excluded:
#
#   internal/fixture   a separate Go module whose ent/ subtree is ent-generated
#   internal/fixtures  this module's codegen fixtures, regenerated by
#                      TestCodegenFixtures on every `make test`
#
# Both are generated (DO NOT EDIT). gofmt/goimports walk the filesystem rather
# than the module graph, so they must be pointed at an explicit list or they
# rewrite import grouping in generated files on every run — and for
# internal/fixtures that fight is unwinnable, since the next test run rewrites
# them back.
#
# internal/fixtures/*/ent/schema is hand-written but sits under the excluded
# prefix; keep it gofmt-clean by hand.
FMT_FILES = $(shell find . -name '*.go' -not -path './internal/fixture/*' -not -path './internal/fixtures/*')

# Includes TestCodegenFixtures, which regenerates internal/fixtures/*/ent and
# compiles the result. It is the only gate that proves generated code builds,
# so it stays in the default target. Adds roughly 2s.
test:
	go test -count=1 -v ./...

# The two nested Go modules. Both are separate modules because they need a SQL
# driver and this library must not have one, which is exactly why `go test ./...`
# above does not descend into them — and a gate nobody runs is not a gate.
#
#   internal/fixture              the #22 spike: the hand-written target this
#                                 generator has to reproduce, ~40 subtests
#                                 against real ent and SQLite. It is the
#                                 specification, so it breaking is the signal
#                                 that generated output has drifted from it.
#   internal/fixtures/wiring/e2e  the behavioural half of the wiring fixture.
#                                 Compiling generated wiring proves it
#                                 type-checks; only this proves it returns the
#                                 right page.
#   internal/softdeleteproof      the behavioural half of the soft-delete
#                                 traverser. It is the ONLY evidence for #18's
#                                 load-bearing criterion — that a direct
#                                 client.Doc.Query(), with nothing generated in
#                                 the call path, does not return deleted rows.
#                                 A compile proof cannot tell "the predicate is
#                                 generated" from "the predicate reaches the
#                                 SQL", so outside this gate it is documentation
#                                 rather than a gate.
#
# Measured cost: `make check` goes from ~16.5s to ~19.8s for the first two, and
# ~+0.6s for internal/softdeleteproof (measured: 22.1s -> 22.7s, two runs each);
# the target alone runs in ~3.3s on a warm module cache. A cold GOMODCACHE pays
# once for
# modernc.org/sqlite, exactly as it already pays once for entgo.io/ent. It is in
# `check` rather than `test` so the inner loop stays fast — which does mean
# `make test` alone does NOT cover these two.
#
# Nothing here edits any of them. `go test` in internal/fixture is read-only, and
# neither internal/fixtures/wiring/e2e nor internal/softdeleteproof contains any
# generated code — the latter imports internal/fixtures/softdelete/ent, which
# `make test` has already regenerated by the time this target runs.
test-modules:
	@for m in internal/fixture internal/fixtures/wiring/e2e internal/softdeleteproof; do \
		echo "==> go test ./... in $$m"; \
		( cd $$m && go test -count=1 ./... ) || exit 1; \
	done

cover:
	go test -count=1 -coverprofile=coverage.out ./...
	go tool cover -func=coverage.out | tail -1
	@rm -f coverage.out

lint:
	golangci-lint run ./...

fmt:
	gofmt -w $(FMT_FILES)
	goimports -w -local github.com/githonllc/entdomain $(FMT_FILES)

vet:
	go vet ./...

check: fmt vet test test-modules
